{"cells":[{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bixn42KI9jja","executionInfo":{"status":"ok","timestamp":1793589422229,"user_tz":-540,"elapsed":19211,"user":{"displayName":"민준","userId":"00921789311142467553"}},"outputId":"9b95fa54-8afe-4ae6-8e50-5ce838441d6b"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["import os\n","import cv2\n","import torch\n","from torch.utils.data import Dataset\n","from sklearn.model_selection import train_test_split\n","\n","class MVTecDataset(Dataset):\n","    def __init__(self, data_dir, category, split='train', img_size=(256, 256), val_ratio=0.1):\n","        \"\"\"\n","        MVTec AD 데이터셋 로더 및 전처리 클래스\n","        split: 'train' (정상 학습용), 'val' (임계값 설정용), 'test' (최종 평가용)\n","        \"\"\"\n","        self.data_dir = data_dir\n","        self.category = category\n","        self.split = split\n","        self.img_size = img_size\n","\n","        self.image_paths = []\n","        self.labels = [] # 0: 정상(good), 1: 불량(anomaly)\n","        self.mask_paths = []\n","\n","        self._load_dataset(val_ratio)\n","\n","    def _load_dataset(self, val_ratio):\n","        category_dir = os.path.join(self.data_dir, self.category)\n","\n","        # Train / Val 분할 (정상 이미지만 사용)\n","        if self.split in ['train', 'val']:\n","            train_dir = os.path.join(category_dir, 'train', 'good')\n","            all_train_imgs = [os.path.join(train_dir, f) for f in os.listdir(train_dir) if f.endswith(('.png', '.jpg'))]\n","\n","            # 10%를 검증용으로 분할\n","            train_imgs, val_imgs = train_test_split(all_train_imgs, test_size=val_ratio, random_state=42)\n","\n","            self.image_paths = train_imgs if self.split == 'train' else val_imgs\n","            self.labels = [0] * len(self.image_paths)\n","            self.mask_paths = [None] * len(self.image_paths)\n","\n","        # Test 셋 구성 (정상 및 불량 모두 포함)\n","        elif self.split == 'test':\n","            test_dir = os.path.join(category_dir, 'test')\n","            gt_dir = os.path.join(category_dir, 'ground_truth')\n","\n","            defect_types = os.listdir(test_dir)\n","            for defect in defect_types:\n","                img_dir = os.path.join(test_dir, defect)\n","                imgs = [f for f in os.listdir(img_dir) if f.endswith(('.png', '.jpg'))]\n","\n","                for img_name in imgs:\n","                    self.image_paths.append(os.path.join(img_dir, img_name))\n","                    if defect == 'good':\n","                        self.labels.append(0)\n","                        self.mask_paths.append(None)\n","                    else:\n","                        self.labels.append(1)\n","                        mask_name = img_name.split('.')[0] + '_mask.png'\n","                        self.mask_paths.append(os.path.join(gt_dir, defect, mask_name))\n","\n","    def __len__(self):\n","        return len(self.image_paths)\n","\n","    def __getitem__(self, idx):\n","        # ---------------------------------------------------------\n","        # [OpenCV 전처리 영역]\n","        # 1. 원본 이미지 로드 및 색상 변환 (BGR -> RGB)\n","        # 2. 공통 입력 크기로 Resize\n","        # 3. 파이토치 Tensor 변환 (C, H, W) 및 0~1 정규화\n","        # ---------------------------------------------------------\n","        img_path = self.image_paths[idx]\n","        img = cv2.imread(img_path)\n","        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","        img_resized = cv2.resize(img, self.img_size)\n","\n","        img_tensor = torch.from_numpy(img_resized).float().permute(2, 0, 1) / 255.0\n","\n","        # 정답 마스크(Ground-truth) 전처리\n","        mask_tensor = torch.zeros((1, self.img_size[0], self.img_size[1]))\n","        if self.mask_paths[idx] is not None:\n","            mask = cv2.imread(self.mask_paths[idx], cv2.IMREAD_GRAYSCALE)\n","            # 마스크는 픽셀 값이 깨지지 않도록 INTER_NEAREST 사용했습니다.\n","            mask_resized = cv2.resize(mask, self.img_size, interpolation=cv2.INTER_NEAREST)\n","            mask_tensor = torch.from_numpy(mask_resized).float().unsqueeze(0) / 255.0\n","\n","        return img_tensor, self.labels[idx], mask_tensor, img_path"],"metadata":{"id":"9LXhHbsfMpvW"},"execution_count":null,"outputs":[]}],"metadata":{"colab":{"provenance":[{"file_id":"1y_pq1LX56kwbHfcSR6QWzOy-k0UKFi1n","timestamp":1793588899183},{"file_id":"/v2/external/notebooks/welcome.ipynb","timestamp":1793584286017}]},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}